GEMINI_API_KEY=발급받은_키
GEMINI_MODEL=gemini-2.5-flash-lite
DART_API_KEY=your_dart_api_key_here
KIPRIS_API_KEY=your_kipris_key_here
# One KIPRISPlus applicant-search endpoint. The app changes applicantName per company.
KIPRIS_API_URL=your_kipris_product_endpoint_here
KOSDAQ_TOP_LIMIT=50
# true면 서버 시작 시 마지막 분석 결과(SAVED_REPORTS_PATH)를 불러와 대시보드에 바로 표시 (Gemini 쿼터 절약)
USE_SAVED_REPORTS=false
# 기본값: .cache/saved_reports.json (분석이 끝까지 완료될 때마다 덮어씀)
# SAVED_REPORTS_PATH=
# Optional: comma-separated KSIC industry names to analyze (default: pharma/bio industries).
# BIO_INDUSTRIES=의약품 제조업,기초 의약물질 제조업,의료용품 및 기타 의약 관련제품 제조업,자연과학 및 공학 연구개발업
NAVER_CLIENT_ID=발급받은_Client_ID
NAVER_CLIENT_SECRET=발급받은_Client_Secret